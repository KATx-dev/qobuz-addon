# HTTP server
PORT=3000
HOST=0.0.0.0
REQUEST_TIMEOUT_MS=6000
UPSTREAM_RETRIES=1
CACHE_TTL_SECONDS=300
QOBUZ_ID_SECRET=replace-with-a-long-random-secret

# Provider selection. multi races LastBabe and Qobuz-DL and uses the first usable result.
QOBUZ_PROVIDER=multi
QOBUZ_UPSTREAM_BASE_URL=https://qobuz-dll.vercel.app
LASTBABE_BASE_URL=https://lastbabe.velixir.run
ELJOHNZC_BASE_URL=https://eljohnzc-addon.de.deplexo.com/4433c7caff7fd070309e

# Only for an authorized, documented provider implementation.
# QOBUZ_API_BASE_URL=https://api.example.invalid
# QOBUZ_SEARCH_PATH=/v1/search
# QOBUZ_STREAM_PATH=/v1/tracks/{id}/stream
# QOBUZ_API_TOKEN=
